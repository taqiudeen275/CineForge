# Web
NEXT_PUBLIC_API_BASE_URL=/api
NEXT_PUBLIC_FIREBASE_API_KEY=local-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=localhost
NEXT_PUBLIC_FIREBASE_PROJECT_ID=cineforge-local

# Control API
HTTP_ADDR=:8080
APP_ENV=development
DATABASE_URL=postgres://cineforge:cineforge@localhost:5432/cineforge?sslmode=disable
REDIS_URL=redis://localhost:6379/0
WEB_ORIGIN=http://localhost:3000
SESSION_COOKIE_SECURE=false
FIREBASE_PROJECT_ID=cineforge-local
FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
TEMPORAL_ADDRESS=localhost:7233
GCS_ENDPOINT=http://localhost:4443/storage/v1/
GCS_UPLOAD_ENDPOINT=http://localhost:4443/upload/storage/v1
GCS_BUCKET_QUARANTINE=cineforge-quarantine
GCS_BUCKET_MEDIA=cineforge-media
MAIL_SMTP_ADDR=localhost:1025
MAIL_FROM=CineForge <noreply@cineforge.local>
